# ==============================================================================
# EduConnect — Environment Variables Configuration Template
# Community Service Project (CSP) — Deployment & Configuration
# ==============================================================================
# Copy this file to '.env' and adjust the values for your local or cloud environment.
# NEVER commit the actual '.env' containing production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# 2. MySQL Database Settings
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=educonnect_db
DB_USERNAME=root
DB_PASSWORD=root

# ------------------------------------------------------------------------------
# 3. JWT Security Configuration
# ------------------------------------------------------------------------------
# HMAC-SHA256 Secret (At least 256 bits, base64 encoded recommended for production)
JWT_SECRET=c3VwZXItc2VjdXJlLWVkdWNvbm5lY3Qtand0LXNlY3JldC1rZXktZm9yLWNzcDIwMjYtY29sbGVnZS1wb3J0YWw=
# Token lifespan in milliseconds (86400000 ms = 24 hours)
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 4. CORS Whitelisted Frontend Origins
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins (e.g. for frontend web servers)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# ------------------------------------------------------------------------------
# 5. File Storage & Uploads
# ------------------------------------------------------------------------------
# Directory on server filesystem where contributed documents are stored
UPLOAD_DIR=uploads/resources

# ------------------------------------------------------------------------------
# 6. Default Seed Accounts (For Local Dev / Demo Evaluations)
# ------------------------------------------------------------------------------
INIT_DEFAULT_ACCOUNTS=true

# Initial Administrator / Faculty Coordinator
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=AdminPassword123!

# Initial Demo Student Contributor
STUDENT_EMAIL=student@college.edu
STUDENT_PASSWORD=Password123!

# ------------------------------------------------------------------------------
# 7. Frontend Deployment Configuration
# ------------------------------------------------------------------------------
# Base API URL used by the frontend JavaScript client (injected into window.EDUCONNECT_API_BASE_URL)
FRONTEND_API_BASE_URL=http://localhost:8080/api
